# Public application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Use the publishable key in the browser; never expose the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Waitlist storage: use memory only for local/test. Production must use supabase.
WAITLIST_STORE=memory

# Optional in Sprint 0; required before inviting external users.
SENTRY_DSN=
RESEND_API_KEY=

# Payment provider remains behind an adapter until the Sprint 8 ADR.
PAYMENTS_PROVIDER=disabled
PAYMENTS_WEBHOOK_SECRET=
