# Public application URL (no trailing slash). Used for auth email links, canonical/Open Graph URLs and the
# public page addresses shown in the app; never taken from the request Host. Build-time value: redeploy after changing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Use the publishable key in the browser; never expose the secret key.
# Local stack: copy API_URL and PUBLISHABLE_KEY from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Used only by the waitlist store and administrative jobs (media cleanup), never for user actions.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Media uploads (ADR 0009). Server-only shared secret, at least 32 characters: the server signs what it
# validated and the database verifies it. The SAME value must be stored in Supabase Vault under the name
# `media_signing_secret`. Without it uploads are refused ("unavailable"); nothing else is affected.
MEDIA_SIGNING_SECRET=
# Optional. Public base URL of the media bucket, without a trailing slash. Defaults to
# <NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/media. Change only when media moves to another store.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Form submissions (ADR 0010). Server-only salt (at least 16 characters) for the daily visitor hash used by
# the per-visitor rate limit. Without it every visitor shares one bucket per page; the page limit still applies.
VISITOR_HASH_SALT=
# Server-only secret (at least 32 characters) for administrative jobs: /api/jobs/media-cleanup and
# /api/jobs/analytics with `Authorization: Bearer <CRON_SECRET>`. Without it the jobs answer 503.
CRON_SECRET=
# Customer analytics (ADR 0011). Server-only shared secret, at least 32 characters: the server signs each
# batch of events and the database verifies it. The SAME value must be stored in Supabase Vault under the name
# `analytics_signing_secret`. Without it public pages work and events are dropped. The daily visitor hash
# reuses VISITOR_HASH_SALT above.
ANALYTICS_SIGNING_SECRET=

# Public page reports (Sprint 9). Server-only HMAC key, at least 32 characters. Store the SAME
# value in Supabase Vault as moderation_signing_secret. Without it report submission is unavailable;
# public page rendering continues.
MODERATION_SIGNING_SECRET=
# Waitlist storage: use memory only for local/test. Production must use supabase.
WAITLIST_STORE=memory

# Optional in Sprint 0; required before inviting external users.
SENTRY_DSN=
RESEND_API_KEY=

# Billing (ADR 0014). All server-only. With any of them missing, or with a key that does not match the
# mode, billing is off: no checkout button, limit screens unchanged, the webhook answers 503.
#   off      default
#   sandbox  needs a Stripe TEST key (sk_test_ / rk_test_); every billing screen says it is a test
#   live     needs a Stripe LIVE key and an https NEXT_PUBLIC_APP_URL; real charges
BILLING_MODE=off
# Stripe secret key of the mode above. Prefer a restricted key (Customers, Checkout Sessions,
# Subscriptions, Invoices, Charges, Products, Billing Portal).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint registered at Stripe for <APP_URL>/api/billing/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Shared secret, at least 32 characters: the server signs every snapshot of the provider's state and
# the database verifies it. The SAME value must be stored in Supabase Vault as `billing_signing_secret`.
BILLING_SIGNING_SECRET=
# Local emulator only (scripts/billing-lifecycle.mjs sets it itself). Honoured in sandbox, for a
# loopback address; anything else turns billing off. Never set it on a hosted environment.
STRIPE_API_BASE_URL=

# Custom domains (ADR 0016). All server-only.
# Shared secret, at least 32 characters: the server signs what it read in DNS and the database verifies
# it. The SAME value must be stored in Supabase Vault as `domains_signing_secret`. Without it nobody can
# prove control of a domain: the screen says the check is not available. Nothing else is affected.
DOMAINS_SIGNING_SECRET=
# Hosting provider that attaches a proven hostname to this deployment and issues its certificate.
# A Vercel access token allowed to manage the project's domains, the project id (prj_...) and, for a
# team project, the team id (team_...). Without them control can still be proven, but the hostname is
# not attached: the screen says so.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Local test doubles only (scripts/domains-lifecycle.mjs sets them itself). Each is honoured only for a
# loopback address. Never set them on a hosted environment.
VERCEL_API_BASE_URL=
DOMAINS_DNS_RESOLVER=
